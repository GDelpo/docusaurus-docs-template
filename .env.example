# ============================================================================
# Docusaurus Docs Template - Environment variables
# ============================================================================
# Copy to .env and adjust values:
#   cp .env.example .env
# ============================================================================

# --- Auth Sidecar ---
# Internal URLs of your identity service (container-to-container).
# Replace with your own identity provider or remove the auth sidecar entirely
# if you don't need authentication.
IDENTITY_LOGIN_URL=http://identity_api:8080/api/v1/login
IDENTITY_ME_URL=http://identity_api:8080/api/v1/me

# Use secure cookies (enable when serving over HTTPS)
COOKIE_SECURE=false

# --- CMS Backend ---
CMS_DB_USER=cms
CMS_DB_PASSWORD=changeme
CMS_DB_NAME=cms
CMS_DEBUG=false

# Identity service URLs used by the CMS for JWT validation.
IDENTITY_SERVICE_URL=http://identity_api:8080/api/v1
IDENTITY_EXTERNAL_URL=https://example.com/identity/api/v1
